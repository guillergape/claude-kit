{
  "_LEEME": "Fragmentos para FUSIONAR en ~/.claude/settings.json (nunca copiar tal cual: mantener lo que ya haya). Rellenar con kit/rellenar.py (<PY>, <LAB>, <HOME>). Las claves que empiezan por _solo_windows se fusionan SOLO en Windows (hooks en 'hooks', reglas en 'permissions.allow') y luego se borran; en Mac/Linux se borran sin más. _opcional_prompt_redo_env solo si instala prompt-redo (kit/extras/prompt-redo/README.md): su contenido va dentro de 'env'. Borrar también esta clave _LEEME.",

  "statusLine": {
    "type": "command",
    "command": "<PY> \"<LAB>/costlog/statusline.py\""
  },

  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "<PY> \"<LAB>/costlog/costlog.py\"", "timeout": 30 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "<PY> \"<LAB>/costlog/wait.py\" stop", "timeout": 30 } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "<PY> \"<LAB>/extras/old.py\" purge \"<CARPETA RAIZ A VIGILAR>\" --days 60", "timeout": 30 } ] }
    ]
  },

  "_opcional_prompt_redo_env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "<LAB>/extras/prompt-redo"
  },

  "_solo_windows_hooks_keep_awake": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<HOME>/.claude/hooks/keep-awake.ps1\" start", "timeout": 15 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<HOME>/.claude/hooks/keep-awake.ps1\" stop", "timeout": 15 } ] }
    ],
    "StopFailure": [
      { "hooks": [ { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<HOME>/.claude/hooks/keep-awake.ps1\" stop", "timeout": 15 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<HOME>/.claude/hooks/keep-awake.ps1\" stop", "timeout": 15 } ] }
    ]
  },

  "permissions": {
    "allow": [
      "Bash(<PY> \"<HOME>/.claude/skills/md2pdf/md2pdf.py\":*)",
      "Bash(<PY> \"<HOME>/.claude/skills/moodle/moodle.py\":*)"
    ],
    "additionalDirectories": [
      "<otras carpetas a las que Claude debe poder acceder, p. ej. la de la uni>"
    ]
  },

  "_solo_windows_permissions_allow": [
    "PowerShell(<PY> \"<HOME>/.claude/skills/md2pdf/md2pdf.py\":*)",
    "PowerShell(<PY> \"<HOME>/.claude/skills/moodle/moodle.py\":*)",
    "PowerShell(Get-ChildItem *)",
    "PowerShell(Select-String *)"
  ],

  "modelSettings": {
    "claude-opus-5-5": { "effortLevel": "high" },
    "claude-sonnet-5-5": { "effortLevel": "high" }
  },

  "autoMode": {
    "allow": [
      "$defaults",
      "<excepciones en prosa, ver kit/guias/permisos-y-bloqueos.md>"
    ]
  }
}
